#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3    &kp N4  &kp N5     &kp N6     &kp N7  &kp N8     &kp N9          &kp N0          &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E     &kp R   &kp T      &kp Y      &kp U   &kp I      &kp O           &kp P           &kp BSLH
&kp LCTRL         &kp A         &kp S         &kp D     &kp F   &kp G      &kp H      &kp J   &kp K      &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C     &kp V   &kp B      &kp N      &kp M   &kp COMMA  &kp DOT         &kp UP_ARROW    &kp FSLH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp LGUI  &mo 1   &kp SPACE  &kp ENTER  &mo 2   &kp SEMI   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        lower_layer {
            bindings = <
&kp F12  &kp F1     &kp F2            &kp F3             &kp F4                &kp F5         &kp F6            &kp F7                 &kp F8           &kp F9             &kp F10    &kp F11
&trans   &none      &none             &none              &none                 &none          &mkp LCLK         &mkp RCLK              &none            &none              &none      &kp CAPSLOCK
&trans   &kp TILDE  &kp EQUAL         &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE      &kp SLASH      &kp BACKSLASH     &kp LEFT_ARROW         &kp DOWN_ARROW   &kp UP_ARROW       &kp RIGHT  &kp UNDER
&trans   &kp MINUS  &kp LEFT_BRACKET  &kp LEFT_BRACE     &kp LEFT_PARENTHESIS  &kp LESS_THAN  &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp PLUS   &kp GRAVE
&trans   &trans     &trans            &trans             &trans                &trans         &trans            &trans                 &trans           &none              &none      &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        raise_layer {
            bindings = <
&trans  &none           &none            &none             &none       &none   &none         &none         &none         &none          &none  &none
&trans  &kp K_MUTE      &kp PRINTSCREEN  &kp K_PLAY_PAUSE  &none       &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PAGE_UP    &none  &none
&trans  &kp K_PREVIOUS  &none            &none             &kp K_NEXT  &none   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PAGE_DOWN  &none  &none
&trans  &none           &none            &none             &none       &none   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &none  &none
&trans  &trans          &trans           &trans            &trans      &trans  &trans        &trans        &trans        &none          &none  &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        middle_layer {
            bindings = <
&trans  &none         &none         &none         &none         &none         &none            &none   &none   &none        &none  &none
&trans  &none         &none         &none         &none         &none         &none            &none   &none   &none        &none  &none
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LC(LS(TAB))  &none   &none   &kp LC(TAB)  &none  &bt BT_CLR
&trans  &none         &none         &none         &none         &none         &none            &none   &none   &none        &none  &none
&trans  &trans        &trans        &trans        &trans        &trans        &trans           &trans  &trans  &none        &none  &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
